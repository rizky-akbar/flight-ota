# WhatsApp Admin Configuration
# Enter the WhatsApp Admin phone number with country code (e.g. 6281234567890 for Indonesia, 201xxxxxxxxx for Egypt)
NEXT_PUBLIC_WHATSAPP_ADMIN=6281234567890

# Travelport Galileo Universal API (UAPI) Credentials
# If left empty or TRAVELPORT_USE_MOCK=true, the system will use high-fidelity simulated Galileo data for ID <-> EG routes
TRAVELPORT_ENDPOINT=https://americas.universal-api.pp.travelport.com/B2BGateway/connect/UAPI/AirService
TRAVELPORT_TARGET_BRANCH=P123456
TRAVELPORT_USERNAME=Universal API/uAPI12345678
TRAVELPORT_PASSWORD=YourTravelportPassword123!
TRAVELPORT_USE_MOCK=true
